---
import '../styles/global.css';
import RunningHeader from '../components/RunningHeader.astro';
import Footer from '../components/Footer.astro';
import { abstract, LINKEDIN } from '../data/site';
import newsreader from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title = 'Abdelrhman Fikri, DevOps Engineer', description = abstract, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Abdelrhman Fikri',
  jobTitle: 'DevOps Engineer',
  address: { '@type': 'PostalAddress', addressLocality: 'Cairo', addressCountry: 'EG' },
  url: new URL('/', Astro.site).href,
  sameAs: [LINKEDIN],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href={newsreader} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {
        // storage unavailable: fall back to the system theme
      }
    </script>
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <RunningHeader />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
