---
import { getCollection } from 'astro:content';
import Doc from '../../layouts/Doc.astro';
import Figure from '../../components/Figure.astro';
import Redaction from '../../components/Redaction.astro';
import CopyEmail from '../../components/CopyEmail.astro';
import { figures } from '../../figures';
import { EMAIL } from '../../data/site';

export async function getStaticPaths() {
  const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: all[i + 1] },
  }));
}

const { entry, next } = Astro.props;
const d = entry.data;
const Fig = figures[d.figure];
---

<Doc title={`${d.title} | Abdelrhman Fikri`} description={d.summary}>
  <header class="case-head">
    <div class="num">{d.id}</div>
    <div>
      <p class="mono muted">
        {d.sector}{d.redact && <> · {d.redact} <Redaction /></>}
      </p>
      <h1>{d.title}</h1>
    </div>
  </header>

  <div class="case-body">
    <div>
      <h2>Problem</h2>
      <p>{d.summary}</p>

      {d.constraints && (
        <>
          <h2>Constraints</h2>
          <ul>{d.constraints.map((c) => <li>{c}</li>)}</ul>
        </>
      )}

      <h2>What I built</h2>
    </div>
  </div>

  <div class="case-fig">
    <Figure n={d.order} caption={d.figCaption}><Fig /></Figure>
  </div>

  <div class="case-body">
    <div>
      <ol>{d.steps.map((s) => <li>{s}</li>)}</ol>

      <h2>Result</h2>
      <p><span class="result"><strong>{d.resultStrong}</strong></span>{d.resultRest && <> {d.resultRest}</>}</p>
      <p class="mono muted">Stack: {d.stack.join(', ')}</p>
    </div>
  </div>

  <nav class="case-foot" aria-label="Next steps">
    <div>
      <span class="who">Next post-mortem</span>
      {next ? <a href={`/work/${next.id}/`}>{next.data.title}</a> : <a href="/#work">All post-mortems</a>}
    </div>
    <div>
      <span class="who">Hiring?</span>
      <a href="/cv.pdf">Download CV (PDF)</a>
    </div>
    <div>
      <span class="who">Have a project?</span>
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      <div class="actions"><CopyEmail email={EMAIL} /></div>
    </div>
  </nav>
</Doc>
